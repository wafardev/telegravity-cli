[Unit]
Description=telegravity-cli: Antigravity & MultiGravity Telegram Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Replace 'user' with your Linux username
User=user
WorkingDirectory=/home/user/telegravity-cli
Environment=PATH=/home/user/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/user/telegravity-cli/.venv/bin/python bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
