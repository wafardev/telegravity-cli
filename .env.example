# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Whitelist authorized Telegram User IDs (comma-separated, e.g. 12345678,87654321)
# You can get your User ID by messaging @userinfobot or @rawdatabot on Telegram.
# Leave empty to allow any user (NOT recommended).
ALLOWED_USER_IDS=

# Execution Mode: "ssh" (execute via SSH on remote host) or "local" (run directly on the host)
RUN_MODE=ssh

# Default multigravity profile to use
MGY_PROFILE=default

# SSH Target Configuration (used when RUN_MODE=ssh)
SSH_USER=your_ssh_username
SSH_HOST=your_device_hostname_or_ip
SSH_PORT=22

# Optional path to private SSH key (e.g., ~/.ssh/id_ed25519)
# If omitted, default system SSH keys and ssh-agent will be used.
SSH_KEY_PATH=

# Timeout in seconds for remote commands (default 600s / 10min for agent turns)
SSH_TIMEOUT=600

# Background session watcher poll interval (seconds)
POLL_INTERVAL=3
